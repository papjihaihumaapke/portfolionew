{
  "name": "hilalmalik-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run media && vite",
    "media": "node scripts/optimize-media.mjs",
    "build": "npm run media && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:banned": "node scripts/check-banned.mjs dist && node scripts/check-pdf.mjs",
    "resume:pdf": "node scripts/resume-pdf.mjs",
    "og": "node scripts/og.mjs",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "check:prerender": "node scripts/check-prerender.mjs",
    "serve:dist": "node scripts/serve-dist.mjs",
    "qa": "node scripts/check-prerender.mjs && node scripts/check-banned-report.mjs && node scripts/check-pdf.mjs && node scripts/check-links.mjs && node scripts/check-keyboard.mjs",
    "capture:sites": "node scripts/capture-sites.mjs",
    "covers": "node scripts/make-covers.mjs",
    "media:missing": "node scripts/missing-media.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.1",
    "postcss": "^8.5.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
